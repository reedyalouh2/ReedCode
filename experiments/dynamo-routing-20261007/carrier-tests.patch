+    fn carrier_gap_credit_check(epoch_change: bool, incomplete_snapshot: u8) {
+        use crate::carrier_feed::{CARRIER_FEED_VERSION, CarrierFeedFrame, CarrierFeedOp};
+        use crate::scheduling::overlap::{OverlapSignals, apply_carrier_matches};
+
+        let connector = TestConnector::default();
+        let router = CarrierRouter::new(Some(Arc::new(connector.clone())));
+        router
+            .upsert_worker(
+                7,
+                0..1,
+                Some(&config("http://hub", 1, &[(0, 5)])),
+                BLOCK_SIZE,
+            )
+            .unwrap();
+        let connections = connector.connections.lock();
+        let connection = &connections[0];
+        install(connection, 1, FeedKind::Carrier, vec![(5, plhs(3))]);
+        let worker = WorkerWithDpRank::new(7, 0);
+        let credit = || {
+            let matches = router.find_matches(&plhs(4)).unwrap();
+            assert_eq!(matches.bound[&worker], Some(FeedKind::Carrier));
+            let mut signals = OverlapSignals::default();
+            signals.effective_overlap_blocks.insert(worker, 8.0);
+            signals.effective_cached_tokens.insert(worker, 32);
+            apply_carrier_matches(&mut signals, &matches, BLOCK_SIZE);
+            signals.effective_cached_tokens[&worker]
+        };
+        assert_eq!(credit(), 12);
+        let epoch = if epoch_change { 2 } else { 1 };
+        let seq = if epoch_change { 1 } else { 2 };
+        assert_eq!(
+            connection.replica.apply(CarrierFeedFrame {
+                version: CARRIER_FEED_VERSION,
+                epoch,
+                seq,
+                manifest: [1; 32],
+                kind: FeedKind::Carrier,
+                max_positions: 8,
+                holder: 5,
+                op: CarrierFeedOp::RemoveHolder,
+            }),
+            FeedApply::NeedsSnapshot
+        );
+        assert!(!connection.replica.is_synced());
+        if incomplete_snapshot != 0 {
+            assert_eq!(
+                connection.replica.install_snapshot(CarrierFeedSnapshot {
+                    version: CARRIER_FEED_VERSION,
+                    epoch,
+                    seq: 0,
+                    manifests: if incomplete_snapshot == 2 {
+                        Vec::new()
+                    } else {
+                        vec![ManifestSnapshot {
+                            manifest: [1; 32],
+                            kind: FeedKind::Carrier,
+                            max_positions: 8,
+                            holders: vec![HolderSnapshot {
+                                holder: 5,
+                                hashes: plhs(3),
+                            }],
+                        }]
+                    },
+                }),
+                Ok(FeedApply::NeedsSnapshot)
+            );
+        }
+        let during = credit();
+        println!(
+            "carrier_gap epoch_change={epoch_change} incomplete_snapshot={incomplete_snapshot} before=12 unsynced_credit={during}"
+        );
+        assert_eq!(
+            during, 0,
+            "a known carrier cannot retain positive credit while its feed is unsynced"
+        );
+        assert!(connection.replica.deepest(&[1; 32], &plhs(4)).is_none());
+        assert!(
+            connection
+                .replica
+                .deepest_by_holder(&[1; 32], &plhs(4))
+                .is_empty()
+        );
+        connection
+            .replica
+            .install_snapshot(CarrierFeedSnapshot {
+                version: CARRIER_FEED_VERSION,
+                epoch,
+                seq,
+                manifests: vec![ManifestSnapshot {
+                    manifest: [1; 32],
+                    kind: FeedKind::Carrier,
+                    max_positions: 8,
+                    holders: vec![HolderSnapshot {
+                        holder: 5,
+                        hashes: plhs(1),
+                    }],
+                }],
+            })
+            .unwrap();
+        assert!(connection.replica.is_synced());
+        assert_eq!(credit(), 4);
+    }
+
+    #[test]
+    fn carrier_gap_does_not_score_old_depth_before_snapshot() {
+        carrier_gap_credit_check(false, 0);
