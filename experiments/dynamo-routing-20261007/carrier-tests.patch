+    #[test]
+    fn carrier_gap_feed_epoch_change_does_not_score_old_depth() {
+        carrier_gap_credit_check(true, 0);
+    }
+
+    #[test]
+    fn carrier_gap_incomplete_snapshot_tail_does_not_publish_credit() {
+        carrier_gap_credit_check(false, 1);
+    }
+    #[test]
+    fn carrier_gap_incomplete_snapshot_preserves_known_kind() {
+        carrier_gap_credit_check(false, 2);
+    }
+}
