+#[tokio::test]
+async fn carrier_gap_selection_uses_the_synced_worker_and_books_prefill() {
+    use crate::carrier_feed::{CarrierFeedFrame, CarrierFeedOp, FeedApply};
+
+    let connector = Arc::new(CarrierTestConnector::default());
+    let core = local_core(test_config(false));
+    core.set_carrier_connector(connector.clone());
+    let tokens: Vec<u32> = (1..=12).collect();
+    let hashes = dynamo_kv_hashing::Request::builder()
+        .tokens(tokens.clone())
+        .build()
+        .unwrap()
+        .positional_lineage_hashes(4)
+        .unwrap();
+    for (worker_id, blocks) in [(1, 3), (2, 2)] {
+        let mut request = worker(worker_id);
+        request.carrier = Some(CarrierWorkerConfig {
+            hub_url: format!("http://hub-{worker_id}"),
+            manifest: "00".repeat(32),
+            block_size: 4,
+            instance_ids: HashMap::from([(0, "5".to_string())]),
+        });
+        core.upsert_worker(request).await.unwrap();
+        let replica = connector.replicas.lock().last().unwrap().clone();
+        replica
+            .install_snapshot(CarrierFeedSnapshot {
+                version: CARRIER_FEED_VERSION,
+                epoch: 1,
+                seq: 0,
+                manifests: vec![ManifestSnapshot {
+                    manifest: [0; 32],
+                    kind: FeedKind::Carrier,
+                    max_positions: 8,
+                    holders: vec![HolderSnapshot {
+                        holder: 5,
+                        hashes: hashes[..blocks].to_vec(),
+                    }],
+                }],
+            })
+            .unwrap();
+    }
+    let before = core
+        .select(SelectRequest {
+            prompt: PromptRequest {
+                token_ids: Some(tokens.clone()),
+                ..PromptRequest::default()
+            },
+            ..select_request()
+        })
+        .await
+        .unwrap();
+    assert_eq!(before.worker_id, 1);
+    let replica = connector.replicas.lock()[0].clone();
+    assert_eq!(
+        replica.apply(CarrierFeedFrame {
+            version: CARRIER_FEED_VERSION,
+            epoch: 1,
+            seq: 2,
+            manifest: [0; 32],
+            kind: FeedKind::Carrier,
+            max_positions: 8,
+            holder: 5,
+            op: CarrierFeedOp::RemoveHolder,
+        }),
+        FeedApply::NeedsSnapshot
+    );
+    let response = core
+        .select_and_reserve(SelectAndReserveRequest {
+            prompt: PromptRequest {
+                token_ids: Some(tokens),
+                ..PromptRequest::default()
+            },
+            ..reserve_request("carrier-gap")
+        })
+        .await
+        .unwrap();
+    let loads = core.loads(Some("model"), Some("default"));
+    let booked: usize = loads[0]
+        .loads
+        .iter()
+        .map(|load| load.potential_prefill_tokens)
+        .sum();
+    println!(
+        "carrier_gap_selection: before_worker={} after_worker={} prefill={} booked_prefill={}",
+        before.worker_id, response.worker_id, response.effective_prefill_tokens, booked
+    );
+    core.free_reservation("carrier-gap").await.unwrap();
+    core.shutdown();
+    assert_eq!(response.worker_id, 2);
+    assert_eq!(response.effective_prefill_tokens, 4);
+    assert_eq!(booked, 4);
+}
