+    async fn known_carrier_has_no_credit_while_gap_snapshot_is_blocked() {
+        #[derive(Clone)]
+        struct HeldSnapshot {
+            requests: Arc<AtomicUsize>,
+            entered: Arc<tokio::sync::Notify>,
+            release: Arc<tokio::sync::Semaphore>,
