+
+        async fn held_snapshot(State(state): State<HeldSnapshot>) -> impl IntoResponse {
+            if state.requests.fetch_add(1, Ordering::Relaxed) == 0 {
+                return axum::body::Body::from(snapshot_bytes(0, plhs(3)));
+            }
+            state.entered.notify_one();
+            state.release.acquire().await.unwrap().forget();
+            axum::body::Body::from(snapshot_bytes(2, Vec::new()))
+        }
+
+        let state = HeldSnapshot {
+            requests: Arc::new(AtomicUsize::new(0)),
+            entered: Arc::new(tokio::sync::Notify::new()),
+            release: Arc::new(tokio::sync::Semaphore::new(0)),
+        };
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let hub_url = format!("http://{}", listener.local_addr().unwrap());
