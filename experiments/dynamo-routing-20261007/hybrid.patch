+use std::collections::HashMap;
+use std::io::{self, Read};
+use std::sync::Arc;
+
+use anyhow::{Context, ensure};
+use dynamo_custom_policy_builtin::DefaultWorkerSelector;
+use dynamo_kv_router::indexer::group_boundary::{
+    CacheIdentity, GroupBoundaryIndex, GroupEvent, GroupSpec, QueryOptions, ReuseBoundary,
+    Unavailable, apply_device_boundary,
+};
+use dynamo_kv_router::indexer::{MatchDetails, SyncIndexer, TieredMatchDetails, WorkerTask};
+use dynamo_kv_router::protocols::{
+    BlockHashOptions, RoutingConstraints, StorageTier, WorkerConfigLike, WorkerWithDpRank,
+};
+use dynamo_kv_router::scheduling::overlap::OverlapAnalysis;
+use dynamo_kv_router::scheduling::{ScheduleMode, SchedulingRequest};
+use dynamo_kv_router::zmq_wire::{RawKvEvent, ZmqEventNormalizer};
+use dynamo_kv_router::{
+    ConcurrentRadixTreeCompressed, KvRouterConfig, RadixTree, compute_block_hash_for_seq,
+};
+use dynamo_kv_router::{WorkerLoadProjection, WorkerSelectionInput, WorkerSelector};
+use serde::Deserialize;
+use serde_json::{Value, json};
+
+#[derive(Deserialize)]
+struct Input {
+    block_size: u32,
+    #[serde(default = "default_worker")]
+    worker_id: u64,
+    #[serde(default)]
+    dp_rank: u32,
+    steps: Vec<Step>,
+    manifests: Vec<Manifest>,
+    cache_reads_enabled: bool,
+    max_ancestry_entries: usize,
+}
+#[derive(Deserialize)]
+struct Manifest {
+    worker_id: u64,
+    #[serde(default)]
+    dp_rank: u32,
+    generation: u64,
+    groups: Vec<GroupSpec>,
+}
+
+fn default_worker() -> u64 {
+    1
+}
+
+#[derive(Deserialize)]
+struct Step {
+    id: String,
+    worker_id: Option<u64>,
+    dp_rank: Option<u32>,
+    #[serde(default)]
+    events: Vec<Value>,
+    #[serde(default)]
+    queries: Vec<Query>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Query {
+    id: String,
+    token_ids: Vec<u32>,
+    cache_namespace: Option<String>,
+    lora_name: Option<String>,
+    is_eagle: Option<bool>,
+}
+
+#[derive(Clone, Copy)]
+struct ProbeWorker;
+impl WorkerConfigLike for ProbeWorker {
+    fn data_parallel_start_rank(&self) -> u32 {
+        0
+    }
+    fn data_parallel_size(&self) -> u32 {
+        1
+    }
+    fn max_num_batched_tokens(&self) -> Option<u64> {
+        None
+    }
+    fn total_kv_blocks(&self) -> Option<u64> {
+        Some(16384)
+    }
+}
+
+fn score(
+    details: MatchDetails,
+    block_size: u32,
+    prompt_tokens: usize,
+    workers: &[WorkerWithDpRank],
+    primary: WorkerWithDpRank,
+    boundaries: Option<&[(WorkerWithDpRank, ReuseBoundary)]>,
+) -> anyhow::Result<Value> {
+    let config = KvRouterConfig::default();
+    let tiered = TieredMatchDetails {
+        device: details,
+        ..Default::default()
+    };
+    let analysis = OverlapAnalysis::new(&config, block_size, &tiered);
+    let mut signals = analysis.signals();
+    if let Some(boundaries) = boundaries {
+        for (worker, boundary) in boundaries {
+            apply_device_boundary(&mut signals, *worker, block_size, *boundary);
+        }
+    }
+    let rows: Vec<_> = workers.iter().map(|worker| json!({
+        "worker_id": worker.worker_id, "dp_rank": worker.dp_rank,
+        "device_overlap_blocks": signals.tier_overlap_blocks.device.get(worker).copied().unwrap_or(0),
+        "effective_overlap_blocks": signals.effective_overlap_blocks.get(worker).copied().unwrap_or(0.0),
+        "effective_cached_tokens": signals.effective_cached_tokens.get(worker).copied().unwrap_or(0),
+    })).collect();
+    let request = SchedulingRequest {
+        mode: ScheduleMode::QueryOnly { request_id: None },
+        token_seq: None,
+        isl_tokens: prompt_tokens,
+        lora_name: None,
+        expected_output_tokens: None,
+        affinity_target: None,
+        pinned_worker: None,
+        allowed_worker_ids: None,
+        routing_constraints: RoutingConstraints::default(),
+        router_config_override: None,
+        track_prefill_tokens: true,
+        priority_jump: 0.0,
+        strict_priority: 0,
+        policy_class: None,
+        session_context: None,
+        overlap: signals,
+        kv_transfer_candidates: None,
+        retain_kv_transfer_chain: false,
+        shared_cache_hits: None,
+        worker_loads: workers
+            .iter()
+            .map(|w| (*w, WorkerLoadProjection::default()))
+            .collect(),
+        resp_tx: None,
+    };
+    let cards: HashMap<_, _> = workers.iter().map(|w| (w.worker_id, ProbeWorker)).collect();
+    let selector = DefaultWorkerSelector::new(Some(config), "prefill");
+    let selected = selector.select_worker(WorkerSelectionInput::configured(
+        &cards,
+        &request,
+        request.eligibility(),
+        block_size,
+    ))?;
+    let result = json!({
+        "device_overlap_blocks": request.overlap.tier_overlap_blocks.device.get(&primary).copied().unwrap_or(0),
+        "effective_overlap_blocks": request.overlap.effective_overlap_blocks.get(&primary).copied().unwrap_or(0.0),
+        "effective_cached_tokens": request.overlap.effective_cached_tokens.get(&primary).copied().unwrap_or(0),
+        "workers": rows,
+        "native_selection": {
+            "worker_id": selected.worker.worker_id, "dp_rank": selected.worker.dp_rank,
+            "required_blocks": selected.required_blocks,
+            "effective_overlap_blocks": selected.effective_overlap_blocks,
+            "cached_tokens": selected.cached_tokens,
+            "max_raw_cached_tokens": selected.max_raw_cached_tokens,
+            "selected_raw_cached_tokens": selected.selected_raw_cached_tokens,
+            "potential_decode_blocks": selected.potential_decode_blocks,
+        },
+    });
+    Ok(result)
+}
+
+fn main() -> anyhow::Result<()> {
+    let mut raw_input = String::new();
+    io::stdin().read_to_string(&mut raw_input)?;
+    let input: Input = serde_json::from_str(&raw_input)?;
+    ensure!(input.block_size > 0, "block_size must be positive");
+    let primary = WorkerWithDpRank::new(input.worker_id, input.dp_rank);
+    let mut workers = vec![primary];
+    for step in &input.steps {
+        let worker = WorkerWithDpRank::new(
+            step.worker_id.unwrap_or(input.worker_id),
+            step.dp_rank.unwrap_or(input.dp_rank),
+        );
+        ensure!(
+            worker.dp_rank == 0,
+            "selection probe supports one rank per worker"
+        );
+        if !workers.contains(&worker) {
+            workers.push(worker);
+        }
+    }
+    workers.sort_by_key(|w| (w.worker_id, w.dp_rank));
+    ensure!(
+        input.cache_reads_enabled,
+        "fixture must explicitly enable ordinary prefix-cache reads"
+    );
+    let mut group_index = GroupBoundaryIndex::new(input.max_ancestry_entries);
+    let mut generations = HashMap::new();
+    let mut sequences = HashMap::new();
+    for manifest in input.manifests {
+        let worker = WorkerWithDpRank::new(manifest.worker_id, manifest.dp_rank);
+        ensure!(
+            generations.insert(worker, manifest.generation).is_none(),
+            "duplicate worker manifest"
+        );
+        group_index.register(worker, manifest.generation, manifest.groups);
+        sequences.insert(worker, 0u64);
+    }
+    ensure!(
+        workers.iter().all(|w| generations.contains_key(w)),
+        "complete worker manifests must precede all events"
+    );
+    let mut normalizer = ZmqEventNormalizer::new(input.block_size);
+    let mut radix = RadixTree::new();
+    let crtc = Arc::new(ConcurrentRadixTreeCompressed::new());
+    let (tx, rx) = flume::bounded(16);
+    let crtc_worker = Arc::clone(&crtc);
+    let thread = std::thread::spawn(move || crtc_worker.worker(rx, None));
+    let mut event_id = 0u64;
+    let mut output = Vec::new();
+
+    for step in input.steps {
+        let worker = WorkerWithDpRank::new(
+            step.worker_id.unwrap_or(input.worker_id),
+            step.dp_rank.unwrap_or(input.dp_rank),
+        );
+        let mut events = Vec::new();
+        for (index, value) in step.events.into_iter().enumerate() {
+            let sequence = sequences.get_mut(&worker).unwrap();
+            let boundary_result = match serde_json::from_value::<GroupEvent>(value.clone()) {
+                Ok(event) => group_index.apply(worker, generations[&worker], *sequence, event),
+                Err(_) => {
+                    group_index.invalidate(
+                        worker,
+                        generations[&worker],
+                        Unavailable::UnsupportedMetadata,
+                    );
+                    Err(Unavailable::UnsupportedMetadata)
+                }
+            };
+            *sequence += 1;
+            let boundary_result = format!("{boundary_result:?}");
+            let raw: RawKvEvent = serde_json::from_value(value.clone())
+                .with_context(|| format!("decode event {} in {}", index, step.id))?;
+            let preprocessed = match normalizer.preprocess_with_reason(raw, worker) {
+                Ok(event) => event,
+                Err(reason) => {
+                    events.push(json!({"index": index, "raw": value, "status": "filtered", "reason": reason.as_label(), "boundary_index": boundary_result}));
+                    continue;
+                }
+            };
+            let normalized = normalizer.normalize_preprocessed(preprocessed, event_id, worker);
+            event_id += 1;
+            let Some(placement) = normalized else {
+                events.push(json!({"index": index, "raw": value, "status": "conversion_dropped"}));
+                continue;
+            };
+            // This probe measures the local device path; other tiers need their own native indexes.
+            ensure!(
+                placement.placement.tier == StorageTier::Device,
+                "probe supports device events only"
+            );
+            let normalized_json = serde_json::to_value(&placement)?;
+            let router_event = placement.into_router_event().context("non-worker event")?;
+            let radix_error = radix
+                .apply_event(router_event.clone())
+                .err()
+                .map(|e| e.to_string());
+            let (ack_tx, ack_rx) = tokio::sync::oneshot::channel();
+            tx.send(WorkerTask::EventWithAck {
+                event: router_event,
+                resp: ack_tx,
+            })?;
+            let crtc_applied = ack_rx.blocking_recv()?;
+            // Parent removal can already invalidate descendants. Native workers log later missing removes and continue.
+            let removed = value.get("type").and_then(Value::as_str) == Some("BlockRemoved")
+                || value.get(0).and_then(Value::as_str) == Some("BlockRemoved");
+            let _ = removed; // Stock attention-index errors are evidence; group-index status is recorded independently.
+            events.push(json!({"index": index, "raw": value, "status": "processed", "boundary_index": boundary_result, "radix_error": radix_error, "crtc_applied": crtc_applied, "normalized": normalized_json}));
+        }
+        let mut queries = Vec::new();
+        for query in step.queries {
+            let hashes = compute_block_hash_for_seq(
+                &query.token_ids,
+                input.block_size,
+                BlockHashOptions {
+                    cache_namespace: query.cache_namespace.as_deref(),
+                    lora_name: query.lora_name.as_deref(),
+                    is_eagle: query.is_eagle,
+                    ..Default::default()
+                },
+            );
+            let identity = CacheIdentity {
+                cache_namespace: query.cache_namespace.clone(),
+                lora_name: query.lora_name.clone(),
+            };
+            let options = QueryOptions {
+                cache_reads_enabled: input.cache_reads_enabled,
+                is_eagle: query.is_eagle.unwrap_or(false),
+                has_multimodal: false,
+            };
+            let boundaries: Vec<_> = workers
+                .iter()
+                .map(|w| {
+                    (
+                        *w,
+                        group_index.lookup(
+                            *w,
+                            generations[w],
+                            &query.token_ids,
+                            &identity,
+                            options,
+                        ),
+                    )
+                })
+                .collect();
+            let radix_details = radix.find_match_details(hashes.clone(), false);
+            let stock_radix = score(
+                radix_details.clone(),
+                input.block_size,
+                query.token_ids.len(),
+                &workers,
+                primary,
+                None,
+            )?;
+            let crtc_details = crtc.find_match_details_impl(&hashes, false);
+            let stock_crtc = score(
+                crtc_details.clone(),
+                input.block_size,
+                query.token_ids.len(),
+                &workers,
+                primary,
+                None,
+            )?;
+            let radix_score = score(
+                radix_details,
+                input.block_size,
+                query.token_ids.len(),
+                &workers,
+                primary,
+                Some(&boundaries),
+            )?;
+            let crtc_score = score(
+                crtc_details,
+                input.block_size,
+                query.token_ids.len(),
+                &workers,
+                primary,
+                Some(&boundaries),
+            )?;
+            // Equal-score worker ties are unspecified; compare the actual overlap inputs independently.
+            ensure!(
+                radix_score["workers"] == crtc_score["workers"],
+                "indexers disagree at query {} in {}",
+                query.id,
+                step.id
+            );
+            queries.push(json!({
+                "id": query.id, "input_tokens": query.token_ids.len(), "query_blocks": hashes.len(),
+                "local_block_hashes": hashes.iter().map(|hash| hash.0).collect::<Vec<_>>(),
+                "radix": radix_score, "crtc": crtc_score, "stock_radix": stock_radix, "stock_crtc": stock_crtc,
+                "group_boundaries": boundaries.iter().map(|(w,b)| json!({"worker_id":w.worker_id,"dp_rank":w.dp_rank,"boundary":b})).collect::<Vec<_>>(),
+            }));
+        }
+        output.push(json!({"id": step.id, "worker_id": worker.worker_id, "dp_rank": worker.dp_rank, "events": events, "queries": queries}));
+    }
+    drop(tx);
+    thread
+        .join()
+        .map_err(|_| anyhow::anyhow!("CRTC worker panicked"))??;
+    println!(
+        "{}",
+        serde_json::to_string_pretty(&json!({
+            "dynamo_revision": "548a010548d53ff05e76397f5f1d3a669e4678e1",
+            "scope": "local prototype: complete group manifests and sparse ancestry correction applied before native builtin selection; no live server integration",
+            "block_size": input.block_size, "worker_id": input.worker_id, "dp_rank": input.dp_rank,
+            "steps": output,
+        }))?
+    );
+    Ok(())
+}
