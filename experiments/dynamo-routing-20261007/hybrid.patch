+
+use std::io::Write;
+use std::path::PathBuf;
+
+use anyhow::{Context, ensure};
+use dynamo_custom_policy_builtin::default_registry;
+use dynamo_kv_router::services::selection::{SelectionServiceBuilder, run_server_on};
+use dynamo_kv_router::{KvRouterConfig, WorkerType};
+use serde_json::json;
+use tokio::net::TcpListener;
+
+#[tokio::main]
+async fn main() -> anyhow::Result<()> {
+    let mut args = std::env::args().skip(1);
+    let ready_path = PathBuf::from(args.next().context("expected ready-file path")?);
+    let indexer_threads: usize = args.next().unwrap_or_else(|| "2".into()).parse()?;
+    let config: KvRouterConfig = match args.next() {
+        Some(path) => serde_json::from_slice(&std::fs::read(path)?)?,
+        None => KvRouterConfig::default(),
+    };
+    ensure!(args.next().is_none(), "unexpected argument");
+    let service = SelectionServiceBuilder::new(config, WorkerType::Aggregated, default_registry())
+        .indexer_threads(indexer_threads)
+        .build()
+        .await?;
+    let listener = TcpListener::bind(("127.0.0.1", 0)).await?;
+    let address = listener.local_addr()?;
+    let mut ready = std::fs::OpenOptions::new().write(true).create_new(true).open(ready_path)?;
+    writeln!(ready, "{}", json!({
+        "url": format!("http://{address}"),
+        "pid": std::process::id(),
+        "indexer_threads": indexer_threads,
+        "selector": "dynamo_builtin_default",
+        "scope": "standalone selection service; no model request forwarding",
+    }))?;
+    ready.sync_all()?;
+    run_server_on(listener, service).await
+}
