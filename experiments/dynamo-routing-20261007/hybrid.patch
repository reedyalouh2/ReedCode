@@ -0,0 +1,559 @@
+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Local-device text-cache boundaries for a complete, versioned group manifest.
+//! Sparse ancestry follows vLLM #44488. Ancestry establishes identity, never residency.
+
+use crate::protocols::{
+    BlockHashOptions, WorkerWithDpRank, compute_block_hash_for_seq, compute_next_seq_hash,
+};
+use crate::scheduling::OverlapSignals;
+use serde::{Deserialize, Serialize};
+use std::collections::{HashMap, HashSet};
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum GroupKind {
+    FullAttention,
+    Mamba,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+pub struct GroupSpec {
+    pub group_idx: u32,
+    pub kind: GroupKind,
+    pub block_size: u32,
+    pub sliding_window: Option<u32>,
+}
+
+#[derive(Clone, Debug, Default, Deserialize, Serialize, PartialEq, Eq, Hash)]
+pub struct CacheIdentity {
+    #[serde(alias = "cache_salt")]
+    pub cache_namespace: Option<String>,
+    pub lora_name: Option<String>,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct QueryOptions {
+    pub cache_reads_enabled: bool,
+    pub is_eagle: bool,
+    pub has_multimodal: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct GroupReuseQuery {
+    pub cache_reads_declared: Option<bool>,
+    pub tokens: Option<std::sync::Arc<[u32]>>,
+    pub identity: CacheIdentity,
+    pub options: QueryOptions,
+}
+
+impl QueryOptions {
+    pub fn ordinary() -> Self {
+        Self {
+            cache_reads_enabled: true,
+            is_eagle: false,
+            has_multimodal: false,
+        }
+    }
+}
+
+#[derive(Clone, Debug, Deserialize)]
+#[serde(tag = "type")]
+pub enum GroupEvent {
+    BlockStored {
+        block_hashes: Vec<u64>,
+        parent_block_hash: Option<u64>,
+        token_ids: Vec<u32>,
+        block_size: u32,
+        group_idx: Option<u32>,
+        kv_cache_spec_kind: Option<GroupKind>,
+        #[serde(flatten)]
+        identity: CacheIdentity,
+        skipped_parent_block_hash: Option<u64>,
+        skipped_token_ids: Option<Vec<u32>>,
+        skipped_extra_keys: Option<Vec<Option<serde_json::Value>>>,
+        extra_keys: Option<Vec<Option<serde_json::Value>>>,
+        is_eagle: Option<bool>,
+        lora_id: Option<u64>,
+        medium: Option<String>,
+        locality: Option<String>,
+        ownership: Option<String>,
+        block_mm_infos: Option<serde_json::Value>,
+    },
+    BlockRemoved {
+        block_hashes: Vec<u64>,
+        group_idx: Option<u32>,
+        medium: Option<String>,
+        locality: Option<String>,
+        ownership: Option<String>,
+    },
+    AllBlocksCleared {
+        ownership: Option<String>,
+    },
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum Unavailable {
+    NoManifest,
+    WrongGeneration,
+    SequenceGap,
+    InvalidManifest,
+    UnsupportedMetadata,
+    MissingParent,
+    InvalidSpan,
+    ConflictingIdentity,
+    AncestryLimit,
+}
+
+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+#[serde(tag = "status", rename_all = "snake_case")]
+pub enum ReuseBoundary {
+    DenseOnly,
+    Available { tokens: usize },
+    Unavailable { reason: Unavailable },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+struct Prefix {
+    end: usize,
+    sequence: u64,
+}
+
+#[derive(Default)]
+struct GroupState {
+    ancestry: HashMap<(CacheIdentity, u64), Prefix>,
+    resident: HashMap<(CacheIdentity, u64), Prefix>,
+    live: HashMap<(CacheIdentity, Prefix), usize>,
+}
+
+struct WorkerState {
+    generation: u64,
+    next_sequence: u64,
+    specs: Vec<GroupSpec>,
+    groups: HashMap<u32, GroupState>,
+    unavailable: Option<Unavailable>,
+}
+
+/// Single-owner state, intended to share the event/index epoch with the attention index.
+/// Reaching the explicit lineage bound discards credit until a clear or new generation.
+pub struct GroupBoundaryIndex {
+    workers: HashMap<WorkerWithDpRank, WorkerState>,
+    max_ancestry_entries: usize,
+}
+
+impl GroupBoundaryIndex {
+    pub fn new(max_ancestry_entries: usize) -> Self {
+        assert!(max_ancestry_entries > 0);
+        Self {
+            workers: HashMap::new(),
+            max_ancestry_entries,
+        }
+    }
+
+    /// A trusted registration must enumerate every required cacheable group before any events.
+    pub fn register(&mut self, worker: WorkerWithDpRank, generation: u64, specs: Vec<GroupSpec>) {
+        let mut ids = HashSet::new();
+        let valid = !specs.is_empty()
+            && specs
+                .iter()
+                .all(|g| g.block_size > 0 && g.sliding_window.is_none() && ids.insert(g.group_idx));
+        self.workers.insert(
+            worker,
+            WorkerState {
+                generation,
+                next_sequence: 0,
+                groups: specs
+                    .iter()
+                    .map(|g| (g.group_idx, GroupState::default()))
+                    .collect(),
+                specs,
+                unavailable: (!valid).then_some(Unavailable::InvalidManifest),
+            },
+        );
+    }
+
+    pub fn unavailable(&self, worker: WorkerWithDpRank, generation: u64) -> Option<Unavailable> {
+        match self.workers.get(&worker) {
+            Some(state) if state.generation == generation => state.unavailable,
+            Some(_) => Some(Unavailable::WrongGeneration),
+            None => Some(Unavailable::NoManifest),
+        }
+    }
+
+    pub fn remove(&mut self, worker: WorkerWithDpRank) {
+        self.workers.remove(&worker);
+    }
+
+    pub fn invalidate(&mut self, worker: WorkerWithDpRank, generation: u64, reason: Unavailable) {
+        if let Some(state) = self.workers.get_mut(&worker) {
+            if state.generation == generation {
+                state.fail(reason);
+            }
+        }
+    }
+
+    pub fn apply(
+        &mut self,
+        worker: WorkerWithDpRank,
+        generation: u64,
+        sequence: u64,
+        event: GroupEvent,
+    ) -> Result<(), Unavailable> {
+        let state = self
+            .workers
+            .get_mut(&worker)
+            .ok_or(Unavailable::NoManifest)?;
+        if state.generation != generation {
+            return Err(Unavailable::WrongGeneration);
+        }
+        if sequence != state.next_sequence {
+            state.fail(Unavailable::SequenceGap);
+            return Err(Unavailable::SequenceGap);
+        }
+        state.next_sequence += 1;
+        if let GroupEvent::AllBlocksCleared { ownership } = &event {
+            if ownership.is_some() {
+                state.fail(Unavailable::UnsupportedMetadata);
+                return Err(Unavailable::UnsupportedMetadata);
+            }
+            state
+                .groups
+                .values_mut()
+                .for_each(|g| *g = GroupState::default());
+            if state.unavailable != Some(Unavailable::InvalidManifest) {
+                state.unavailable = None;
+            }
+            return Ok(());
+        }
+        if let Some(reason) = state.unavailable {
+            return Err(reason);
+        }
+        let result = state.apply(event).and_then(|()| {
+            if state
+                .groups
+                .values()
+                .map(|g| g.ancestry.len())
+                .sum::<usize>()
+                > self.max_ancestry_entries
+            {
+                Err(Unavailable::AncestryLimit)
+            } else {
+                Ok(())
+            }
+        });
+        if let Err(reason) = result {
+            state.fail(reason);
+        }
+        result
+    }
+
+    pub fn lookup(
+        &self,
+        worker: WorkerWithDpRank,
+        generation: u64,
+        tokens: &[u32],
+        identity: &CacheIdentity,
+        options: QueryOptions,
+    ) -> ReuseBoundary {
+        if !options.cache_reads_enabled {
+            return ReuseBoundary::Available { tokens: 0 };
+        }
+        if options.is_eagle || options.has_multimodal {
+            return ReuseBoundary::Unavailable {
+                reason: Unavailable::UnsupportedMetadata,
+            };
+        }
+        let Some(state) = self.workers.get(&worker) else {
+            return ReuseBoundary::Unavailable {
+                reason: Unavailable::NoManifest,
+            };
+        };
+        if state.generation != generation {
+            return ReuseBoundary::Unavailable {
+                reason: Unavailable::WrongGeneration,
+            };
+        }
+        // Dense models retain the established attention path, including its reporting convention.
+        if !state.specs.is_empty()
+            && !state.specs.iter().any(|g| g.kind == GroupKind::Mamba)
+            && state.unavailable != Some(Unavailable::InvalidManifest)
+        {
+            return ReuseBoundary::DenseOnly;
+        }
+        if let Some(reason) = state.unavailable {
+            return ReuseBoundary::Unavailable { reason };
+        }
+        let mut allowed: Option<HashSet<usize>> = None;
+        for spec in &state.specs {
+            let group = &state.groups[&spec.group_idx];
+            let prefixes = prefixes(tokens, spec.block_size, identity, None);
+            let mut ends = HashSet::new();
+            for prefix in prefixes {
+                if prefix.end >= tokens.len() {
+                    break;
+                }
+                let present = group.live.contains_key(&(identity.clone(), prefix));
+                if !present && spec.kind == GroupKind::FullAttention {
+                    break;
+                }
+                if present {
+                    ends.insert(prefix.end);
+                }
+            }
+            match &mut allowed {
+                Some(current) => current.retain(|end| ends.contains(end)),
+                None => allowed = Some(ends),
+            }
+        }
+        ReuseBoundary::Available {
+            tokens: allowed.and_then(|ends| ends.into_iter().max()).unwrap_or(0),
+        }
+    }
+}
+
+impl WorkerState {
+    fn fail(&mut self, reason: Unavailable) {
+        self.unavailable = Some(reason);
+        self.groups
+            .values_mut()
+            .for_each(|g| *g = GroupState::default());
+    }
+
+    fn apply(&mut self, event: GroupEvent) -> Result<(), Unavailable> {
+        match event {
+            GroupEvent::AllBlocksCleared { .. } => unreachable!(),
+            GroupEvent::BlockRemoved {
+                block_hashes,
+                group_idx,
+                medium,
+                locality,
+                ownership,
+            } => {
+                local_device(medium.as_deref(), locality.as_deref())?;
+                if ownership.is_some() {
+                    return Err(Unavailable::UnsupportedMetadata);
+                }
+                let group = self
+                    .groups
+                    .get_mut(&group_idx.ok_or(Unavailable::InvalidManifest)?)
+                    .ok_or(Unavailable::InvalidManifest)?;
+                for hash in block_hashes {
+                    // Removal has no namespace; invalidate every local identity with this engine key.
+                    let keys: Vec<_> = group
+                        .resident
+                        .keys()
+                        .filter(|(_, h)| *h == hash)
+                        .cloned()
+                        .collect();
+                    for key in keys {
+                        if let Some(prefix) = group.resident.remove(&key) {
+                            let live_key = (key.0, prefix);
+                            let count = group.live.get_mut(&live_key).unwrap();
+                            *count -= 1;
+                            if *count == 0 {
+                                group.live.remove(&live_key);
+                            }
+                        }
+                    }
+                }
+                Ok(())
+            }
+            GroupEvent::BlockStored {
+                block_hashes,
+                parent_block_hash,
+                token_ids,
+                block_size,
+                group_idx,
+                kv_cache_spec_kind,
+                identity,
+                skipped_parent_block_hash,
+                skipped_token_ids,
+                skipped_extra_keys,
+                extra_keys,
+                is_eagle,
+                lora_id,
+                medium,
+                locality,
+                ownership,
+                block_mm_infos,
+            } => {
+                local_device(medium.as_deref(), locality.as_deref())?;
+                if is_eagle.unwrap_or(false)
+                    || (lora_id.is_some() && identity.lora_name.is_none())
+                    || ownership.is_some()
+                    || block_mm_infos.is_some()
+                {
+                    return Err(Unavailable::UnsupportedMetadata);
+                }
+                let id = group_idx.ok_or(Unavailable::InvalidManifest)?;
+                let spec = self
+                    .specs
+                    .iter()
+                    .find(|g| g.group_idx == id)
+                    .ok_or(Unavailable::InvalidManifest)?;
+                if block_size != spec.block_size
+                    || kv_cache_spec_kind.is_some_and(|kind| kind != spec.kind)
+                {
+                    return Err(Unavailable::InvalidManifest);
+                }
+                let group = self.groups.get_mut(&id).unwrap();
+                if token_ids.len()
+                    != block_hashes
+                        .len()
+                        .checked_mul(block_size as usize)
+                        .ok_or(Unavailable::InvalidSpan)?
+                {
+                    return Err(Unavailable::InvalidSpan);
+                }
+                check_extra(&extra_keys, block_hashes.len())?;
+                let base = if let Some(skipped) = skipped_token_ids {
+                    if skipped.is_empty()
+                        || skipped.len() % block_size as usize != 0
+                        || parent_block_hash.is_none()
+                    {
+                        return Err(Unavailable::InvalidSpan);
+                    }
+                    check_extra(&skipped_extra_keys, skipped.len() / block_size as usize)?;
+                    let ancestor = parent(group, &identity, skipped_parent_block_hash)?;
+                    let skipped_prefixes = prefixes(&skipped, block_size, &identity, ancestor);
+                    let end = *skipped_prefixes.last().ok_or(Unavailable::InvalidSpan)?;
+                    record_ancestry(group, &identity, parent_block_hash.unwrap(), end)?;
+                    Some(end)
+                } else {
+                    if skipped_parent_block_hash.is_some() || skipped_extra_keys.is_some() {
+                        return Err(Unavailable::InvalidSpan);
+                    }
+                    parent(group, &identity, parent_block_hash)?
+                };
+                for (hash, prefix) in block_hashes
+                    .into_iter()
+                    .zip(prefixes(&token_ids, block_size, &identity, base))
+                {
+                    record_ancestry(group, &identity, hash, prefix)?;
+                    if group
+                        .resident
+                        .insert((identity.clone(), hash), prefix)
+                        .is_none()
+                    {
+                        *group.live.entry((identity.clone(), prefix)).or_default() += 1;
+                    }
+                }
+                Ok(())
+            }
+        }
+    }
+}
+
+fn local_device(medium: Option<&str>, locality: Option<&str>) -> Result<(), Unavailable> {
+    if medium.is_some_and(|m| m != "GPU") || locality.is_some_and(|l| l != "LOCAL") {
+        Err(Unavailable::UnsupportedMetadata)
+    } else {
+        Ok(())
+    }
+}
+
+fn check_extra(
+    keys: &Option<Vec<Option<serde_json::Value>>>,
+    len: usize,
+) -> Result<(), Unavailable> {
+    if keys
+        .as_ref()
+        .is_some_and(|keys| keys.len() != len || keys.iter().any(Option::is_some))
+    {
+        return Err(Unavailable::UnsupportedMetadata);
+    }
+    Ok(())
+}
+
+fn parent(
+    group: &GroupState,
+    identity: &CacheIdentity,
+    hash: Option<u64>,
+) -> Result<Option<Prefix>, Unavailable> {
+    hash.map(|hash| {
+        group
+            .ancestry
+            .get(&(identity.clone(), hash))
+            .copied()
+            .ok_or(Unavailable::MissingParent)
+    })
+    .transpose()
+}
+
+fn record_ancestry(
+    group: &mut GroupState,
+    identity: &CacheIdentity,
+    hash: u64,
+    prefix: Prefix,
+) -> Result<(), Unavailable> {
+    let key = (identity.clone(), hash);
+    if group.ancestry.get(&key).is_some_and(|old| *old != prefix) {
+        return Err(Unavailable::ConflictingIdentity);
+    }
+    group.ancestry.insert(key, prefix);
+    Ok(())
+}
+
+fn prefixes(
+    tokens: &[u32],
+    block_size: u32,
+    identity: &CacheIdentity,
+    mut previous: Option<Prefix>,
+) -> Vec<Prefix> {
+    compute_block_hash_for_seq(
+        tokens,
+        block_size,
+        BlockHashOptions {
+            cache_namespace: identity.cache_namespace.as_deref(),
+            lora_name: identity.lora_name.as_deref(),
+            ..Default::default()
+        },
+    )
+    .into_iter()
+    .map(|hash| {
+        let prefix = Prefix {
+            end: previous.map_or(0, |p| p.end) + block_size as usize,
+            sequence: previous.map_or(hash.0, |p| compute_next_seq_hash(p.sequence, hash)),
+        };
+        previous = Some(prefix);
+        prefix
+    })
+    .collect()
+}
+
+/// Apply a local-device hybrid boundary to every overlap credit consumed by the default scorer.
+/// Host, disk and shared-cache reuse are outside this prototype's supported configuration.
+pub fn apply_device_boundary(
+    signals: &mut OverlapSignals,
+    worker: WorkerWithDpRank,
+    router_block_size: u32,
+    boundary: ReuseBoundary,
+) {
+    let tokens = match boundary {
+        ReuseBoundary::DenseOnly => return,
+        ReuseBoundary::Available { tokens } => tokens,
+        ReuseBoundary::Unavailable { .. } => 0,
+    };
+    assert!(router_block_size > 0);
+    let raw = signals
+        .tier_overlap_blocks
+        .device
+        .get(&worker)
+        .copied()
+        .unwrap_or(0);
+    let blocks = raw.min(tokens / router_block_size as usize);
+    signals.tier_overlap_blocks.device.insert(worker, blocks);
+    signals.tier_overlap_blocks.host_pinned.remove(&worker);
+    signals.tier_overlap_blocks.disk.remove(&worker);
+    signals
+        .effective_overlap_blocks
+        .insert(worker, blocks as f64);
+    signals
+        .effective_cached_tokens
+        .insert(worker, blocks * router_block_size as usize);
+}
