+fn worker() -> WorkerWithDpRank {
+    WorkerWithDpRank::new(1, 0)
+}
+fn manifest(block_size: u32) -> Vec<GroupSpec> {
+    vec![
+        GroupSpec {
+            group_idx: 0,
+            kind: GroupKind::FullAttention,
+            block_size,
+            sliding_window: None,
+        },
+        GroupSpec {
+            group_idx: 1,
+            kind: GroupKind::Mamba,
+            block_size,
+            sliding_window: None,
+        },
+    ]
+}
+fn index() -> GroupBoundaryIndex {
+    let mut index = GroupBoundaryIndex::new(1000);
+    index.register(worker(), 1, manifest(16));
+    index
+}
+fn tokens(n: usize) -> Vec<u32> {
+    (1000..1000 + n as u32).collect()
+}
+fn dense(group: u32, n: usize) -> Value {
+    json!({"type":"BlockStored", "group_idx":group, "block_hashes": (1..=n/16).collect::<Vec<_>>(),
+           "token_ids":tokens(n), "block_size":16, "parent_block_hash":null})
+}
+fn checkpoint(end: usize) -> Value {
+    let all = tokens(end);
+    if end == 16 {
+        json!({"type":"BlockStored","group_idx":1,"block_hashes":[1],"token_ids":all,"block_size":16})
+    } else {
+        json!({"type":"BlockStored","group_idx":1,"block_hashes":[end/16],"token_ids":all[end-16..],"block_size":16,
+            "parent_block_hash":end/16-1,"skipped_parent_block_hash":null,"skipped_token_ids":all[..end-16],
+            "skipped_extra_keys":vec![None::<u32>;end/16-1]})
+    }
+}
+fn apply(index: &mut GroupBoundaryIndex, sequence: u64, event: Value) -> Result<(), Unavailable> {
+    index.apply(
+        worker(),
+        1,
+        sequence,
+        serde_json::from_value(event).unwrap(),
+    )
+}
+fn lookup(index: &GroupBoundaryIndex, query: &[u32]) -> ReuseBoundary {
+    index.lookup(
+        worker(),
+        1,
+        query,
+        &CacheIdentity::default(),
+        QueryOptions::ordinary(),
+    )
+}
