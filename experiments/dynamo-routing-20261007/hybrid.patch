+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Opt-in registration for local-device hybrid cache boundaries."""
+
+import asyncio
+import json
+import logging
+import os
+import urllib.request
+import uuid
+from dataclasses import dataclass
+from typing import Any
+
+ACTIVATION_ENV = "DYN_VLLM_GROUP_REUSE"
+UTILITY_NAME = "get_dynamo_group_reuse_metadata"
+SPARSE_CONTRACT = "vllm_44488_v1"
+SELECTION_URL_ENV = "DYN_VLLM_GROUP_REUSE_SELECTION_URL"
+logger = logging.getLogger(__name__)
+
+
+def get_group_reuse_metadata(engine_core: Any) -> dict[str, Any]:
+    from vllm.v1.core import block_pool
+
+    if getattr(block_pool, "DYNAMO_SPARSE_EVENT_CONTRACT", None) != SPARSE_CONTRACT:
+        raise ValueError("group reuse requires the qualified sparse-event emitter")
+    manager = engine_core.scheduler.kv_cache_manager
+    config = engine_core.vllm_config
+    parallel = config.parallel_config
+    if any(
+        getattr(parallel, name) != 1
+        for name in ("tensor_parallel_size", "pipeline_parallel_size", "data_parallel_size")
+    ):
+        raise ValueError("group reuse currently requires TP=PP=DP=1")
+    if not manager.enable_caching or not manager.enable_kv_cache_events:
+        raise ValueError("group reuse requires prefix caching and KV events")
+    if manager.use_eagle or config.speculative_config is not None:
+        raise ValueError("group reuse does not support speculative decoding")
+    if manager.mamba_fine_grained_prefix_cache:
+        raise ValueError("group reuse does not support fine-grained Mamba caching")
+    groups = engine_core.get_kv_cache_group_metadata()
+    managers = manager.coordinator.single_type_managers
+    specs = manager.kv_cache_config.kv_cache_groups
+    if not groups or len(groups) != len(managers) or len(groups) != len(specs):
+        raise ValueError("group reuse requires complete cache-group metadata")
+    hash_size = manager.block_pool.hash_block_size
+    if hash_size <= 0:
+        raise ValueError("group reuse requires a positive hash block size")
+    for index, (group, typed, spec) in enumerate(zip(groups, managers, specs, strict=True)):
+        if (
+            group["group_idx"] != index
+            or group["block_size"] != hash_size
+            or typed.block_size != hash_size
+            or group["sliding_window"] is not None
+            or typed.dcp_world_size != 1
+            or typed.pcp_world_size != 1
+        ):
+            raise ValueError("group reuse requires equal local cache/hash geometry")
+        kind = group["kind"]
+        if kind not in {"full_attention", "mamba"}:
+            raise ValueError(f"unsupported group reuse cache kind: {kind}")
+        if kind == "mamba" and spec.kv_cache_spec.mamba_cache_mode != "align":
+            raise ValueError("group reuse requires align-mode Mamba")
+    if manager.coordinator.num_reprefillable_tokens:
+        raise ValueError("group reuse does not support prefill lookahead")
+    events = config.kv_events_config
+    if events is None or not events.enable_kv_cache_events or events.publisher != "zmq":
+        raise ValueError("group reuse requires the native ZMQ publisher")
+    if not getattr(engine_core, "_dynamo_group_reuse_incarnation", None):
+        engine_core._dynamo_group_reuse_incarnation = str(uuid.uuid4())
+    return {
+        "version": 1,
+        "engine_incarnation": engine_core._dynamo_group_reuse_incarnation,
+        "hash_block_size": hash_size,
+        "sparse_ancestry": SPARSE_CONTRACT,
+        "groups": groups,
+    }
+
+
+def install_group_reuse_utility(engine_core_type: type) -> None:
+    if os.environ.get(ACTIVATION_ENV) == "1":
+        setattr(engine_core_type, UTILITY_NAME, get_group_reuse_metadata)
+
+
+def _post_worker(url: str, body: dict[str, Any], timeout: float) -> dict[str, Any]:
+    request = urllib.request.Request(
+        url.rstrip("/") + "/workers",
+        data=json.dumps(body).encode(),
+        headers={"Content-Type": "application/json"},
+        method="POST",
+    )
+    with urllib.request.urlopen(request, timeout=timeout) as response:
+        result = json.load(response)
+    expected = body["group_reuse"]
+    if (
+        result.get("group_reuse_version") != 1
+        or result.get("group_reuse_engine_incarnation") != expected["engine_incarnation"]
+        or result.get("group_reuse") != expected
+        or result.get("lifecycle") != "schedulable"
+        or result.get("not_schedulable_reasons", [])
+    ):
+        try:
+            GroupReuseRegistration(url, body["worker_id"]).close()
+        except Exception:
+            logger.exception("Failed to remove an unacknowledged group reuse worker")
+        raise ValueError("selection service did not acknowledge group reuse registration")
+    return result
+
+
+@dataclass
+class GroupReuseRegistration:
+    selection_url: str
+    worker_id: int
+
+    def close(self) -> None:
+        request = urllib.request.Request(
+            self.selection_url.rstrip("/") + f"/workers/{self.worker_id}",
+            method="DELETE",
+        )
+        with urllib.request.urlopen(request, timeout=5.0):
+            pass
+
+
+async def register_group_reuse_worker(
+    engine: Any,
+    selection_url: str,
+    worker: dict[str, Any],
+    *,
+    timeout: float = 10.0,
+) -> dict[str, Any]:
+    """Register metadata fetched from the engine, checking the service acknowledgment."""
+    metadata = await engine.engine_core.call_utility_async(UTILITY_NAME)
+    body = dict(worker)
+    if "group_reuse" in body:
+        raise ValueError("group reuse metadata must come from the engine utility")
+    if body.get("block_size") != metadata["hash_block_size"]:
+        raise ValueError("worker block size differs from engine hash block size")
+    body["group_reuse"] = metadata
+    return await asyncio.to_thread(_post_worker, selection_url, body, timeout)
+
+
+async def register_group_reuse_from_startup(
+    engine: Any,
+    vllm_config: Any,
+    config: Any,
+    worker_id: int | str,
+    *,
+    aggregated: bool,
+    restored: bool = False,
+) -> GroupReuseRegistration | None:
+    selection_url = os.environ.get(SELECTION_URL_ENV)
+    enabled = os.environ.get(ACTIVATION_ENV) == "1"
+    if not enabled and not selection_url:
+        return None
+    if not enabled or not selection_url:
+        raise ValueError("group reuse requires both activation and selection URL")
+    if restored:
+        raise ValueError("group reuse does not support restored engine snapshots")
+    worker_id = int(worker_id)
+    if not aggregated or config.route_to_encoder:
+        raise ValueError("group reuse currently requires a local aggregated worker")
+    events = vllm_config.kv_events_config
+    if events is None or not events.endpoint:
+        raise ValueError("group reuse requires a native event endpoint")
+    body = {
+        "worker_id": worker_id,
+        "model_name": config.served_model_name or config.model,
+        "endpoint": f"{config.namespace}.{config.component}.{config.endpoint}",
+        "kv_events_endpoint": events.endpoint.replace("*", "127.0.0.1"),
+        "replay_endpoint": events.replay_endpoint,
+        "block_size": vllm_config.additional_config["dynamo_kv_event_block_size"],
+        "data_parallel_start_rank": 0,
+        "data_parallel_size": 1,
+        "max_num_batched_tokens": vllm_config.scheduler_config.max_num_batched_tokens,
+        "total_kv_blocks": vllm_config.cache_config.num_gpu_blocks,
+        "is_eagle": False,
+    }
+    await register_group_reuse_worker(engine, selection_url, body)
+    return GroupReuseRegistration(selection_url, worker_id)
