+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Opt-in local-device group reuse for the direct engine-event ingress.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::Arc;
+
+use parking_lot::Mutex;
+use serde::{Deserialize, Serialize};
+
+use crate::identity::RoutingPartitionId;
+use crate::indexer::group_boundary::{
+    GroupBoundaryIndex, GroupEvent, GroupReuseQuery, GroupSpec, ReuseBoundary, Unavailable,
+    apply_device_boundary,
+};
+use crate::protocols::WorkerWithDpRank;
+use crate::scheduling::OverlapSignals;
+use crate::scheduling::overlap_refresh::OverlapCorrection;
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct GroupReuseRegistration {
+    pub version: u32,
+    pub engine_incarnation: String,
+    pub hash_block_size: u32,
+    pub sparse_ancestry: String,
+    pub groups: Vec<GroupSpec>,
+}
+
+impl GroupReuseRegistration {
+    pub fn validate(&self, block_size: u32, dp_size: u32) -> Result<(), String> {
+        let mut groups = HashSet::new();
+        if self.version != 1 || self.sparse_ancestry != "vllm_44488_v1" {
+            return Err("unsupported group_reuse protocol".into());
+        }
+        if uuid::Uuid::parse_str(&self.engine_incarnation).is_err() {
+            return Err("group_reuse engine_incarnation must be a UUID".into());
+        }
+        if dp_size != 1 || block_size == 0 || self.hash_block_size != block_size {
+            return Err(
+                "group_reuse v1 requires one DP rank and equal hash/router block sizes".into(),
+            );
+        }
+        if self.groups.is_empty()
+            || self.groups.iter().any(|g| {
+                g.block_size != block_size
+                    || g.sliding_window.is_some()
+                    || !groups.insert(g.group_idx)
+            })
+        {
+            return Err(
+                "group_reuse v1 requires a complete, unique, uniform-size group roster".into(),
+            );
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct GroupReuseStatus {
+    pub last_batch_cursor: Option<u64>,
+    pub unavailable: Option<Unavailable>,
+}
+
+struct Source {
+    key: RoutingPartitionId,
+    epoch: u64,
+    next_batch: u64,
+    next_event: u64,
+}
+
+struct State {
+    index: GroupBoundaryIndex,
+    sources: HashMap<WorkerWithDpRank, Source>,
+    next_epoch: u64,
+    endpoints: HashMap<String, (WorkerWithDpRank, GroupReuseRegistration)>,
+}
+
+#[derive(Clone)]
+pub struct GroupReuseIndex(Arc<Mutex<State>>);
+
+impl Default for GroupReuseIndex {
+    fn default() -> Self {
+        Self(Arc::new(Mutex::new(State {
+            index: GroupBoundaryIndex::new(1_000_000),
+            sources: HashMap::new(),
+            next_epoch: 0,
+            endpoints: HashMap::new(),
+        })))
+    }
+}
+
+impl GroupReuseIndex {
+    pub fn check_source(
+        &self,
+        worker: WorkerWithDpRank,
+        endpoint: &str,
+        registration: &GroupReuseRegistration,
+    ) -> Result<(), String> {
+        let state = self.0.lock();
+        if let Some((previous_worker, previous)) = state.endpoints.get(endpoint) {
+            if *previous_worker != worker || previous != registration {
+                return Err("group_reuse requires an event endpoint unique to this engine incarnation and roster".into());
+            }
+        } else if state.endpoints.len() >= 100_000 {
+            return Err("group_reuse endpoint history limit reached".into());
+        }
+        Ok(())
+    }
+
+    pub fn bind_source(
+        &self,
+        worker: WorkerWithDpRank,
+        endpoint: &str,
+        registration: &GroupReuseRegistration,
+    ) -> Result<(), String> {
+        self.check_source(worker, endpoint, registration)?;
+        self.0
+            .lock()
+            .endpoints
+            .entry(endpoint.to_string())
+            .or_insert_with(|| (worker, registration.clone()));
+        Ok(())
+    }
+
+    pub fn register(
+        &self,
+        worker: WorkerWithDpRank,
+        key: RoutingPartitionId,
+        registration: &GroupReuseRegistration,
+    ) -> u64 {
+        let mut state = self.0.lock();
+        state.next_epoch = state
+            .next_epoch
+            .checked_add(1)
+            .expect("group reuse epoch exhausted");
+        let epoch = state.next_epoch;
+        state
+            .index
+            .register(worker, epoch, registration.groups.clone());
+        state.sources.insert(
+            worker,
+            Source {
+                key,
+                epoch,
+                next_batch: 0,
+                next_event: 0,
+            },
+        );
+        epoch
+    }
+
+    pub fn retire(&self, worker: WorkerWithDpRank) {
+        // Keep the zero-credit marker until the old attention index has drained.
+        self.0.lock().index.remove(worker);
+    }
+
+    pub fn remove_worker(&self, worker_id: u64) {
+        let mut state = self.0.lock();
+        let workers: Vec<_> = state
+            .sources
+            .keys()
+            .copied()
+            .filter(|w| w.worker_id == worker_id)
+            .collect();
+        for worker in workers {
+            state.sources.remove(&worker);
+            state.index.remove(worker);
+        }
+    }
+
+    pub fn remove(&self, worker: WorkerWithDpRank) {
+        let mut state = self.0.lock();
+        state.sources.remove(&worker);
+        state.index.remove(worker);
+    }
+
+    pub fn invalidate(&self, worker: WorkerWithDpRank, epoch: u64) {
+        self.0
+            .lock()
+            .index
+            .invalidate(worker, epoch, Unavailable::SequenceGap);
+    }
+
+    /// A batch cursor belongs to the engine stream; event ordinals belong to this consumer.
+    pub fn apply_batch(&self, worker: WorkerWithDpRank, epoch: u64, cursor: u64, payload: &[u8]) {
+        let decoded = rmp_serde::from_slice::<(f64, Vec<serde_json::Value>, Option<i32>)>(payload);
+        let mut state = self.0.lock();
+        let Some(source) = state.sources.get(&worker) else {
+            return;
+        };
+        if source.epoch != epoch {
+            return;
+        }
+        if cursor < source.next_batch {
+            return;
+        }
+        if cursor != source.next_batch {
+            state
+                .index
+                .invalidate(worker, epoch, Unavailable::SequenceGap);
+        }
+        state.sources.get_mut(&worker).unwrap().next_batch = cursor.saturating_add(1);
+        let Ok((_, events, rank)) = decoded else {
+            state
+                .index
+                .invalidate(worker, epoch, Unavailable::UnsupportedMetadata);
+            return;
+        };
+        if rank.is_some_and(|rank| rank < 0 || rank as u32 != worker.dp_rank) {
+            state
+                .index
+                .invalidate(worker, epoch, Unavailable::UnsupportedMetadata);
+            return;
+        }
+        for raw in events {
+            // v1 is the named vLLM event format. Legacy positional layouts remain dense-only.
+            let unsupported = !raw.is_object()
+                || raw
+                    .get("kv_cache_spec_sliding_window")
+                    .is_some_and(|v| !v.is_null());
+            let event = serde_json::from_value::<GroupEvent>(raw);
+            if unsupported || event.is_err() {
+                state
+                    .index
+                    .invalidate(worker, epoch, Unavailable::UnsupportedMetadata);
+                continue;
+            }
+            let source = state.sources.get_mut(&worker).unwrap();
+            let ordinal = source.next_event;
+            source.next_event += 1;
+            let _ = state.index.apply(worker, epoch, ordinal, event.unwrap());
+        }
+    }
+
+    pub fn status(&self, worker: WorkerWithDpRank) -> Option<GroupReuseStatus> {
+        let state = self.0.lock();
+        let source = state.sources.get(&worker)?;
+        Some(GroupReuseStatus {
+            last_batch_cursor: source.next_batch.checked_sub(1),
+            unavailable: state.index.unavailable(worker, source.epoch),
+        })
+    }
+
+    pub fn contains_partition(&self, key: &RoutingPartitionId) -> bool {
+        self.0.lock().sources.values().any(|s| &s.key == key)
+    }
+
+    pub fn correct(
+        &self,
+        key: &RoutingPartitionId,
+        block_size: u32,
+        overlap: &mut OverlapSignals,
+        query: Option<&GroupReuseQuery>,
+    ) {
+        let state = self.0.lock();
+        for (worker, source) in &state.sources {
+            if &source.key != key {
+                continue;
+            }
+            let boundary = match query.and_then(|q| q.tokens.as_ref().map(|t| (q, t))) {
+                Some((query, tokens)) => state.index.lookup(
+                    *worker,
+                    source.epoch,
+                    tokens,
+                    &query.identity,
+                    query.options,
+                ),
+                None => ReuseBoundary::Unavailable {
+                    reason: Unavailable::UnsupportedMetadata,
+                },
+            };
+            apply_device_boundary(overlap, *worker, block_size, boundary);
+        }
+        if query.is_some_and(|q| q.cache_reads_declared == Some(false)) {
+            *overlap = OverlapSignals::default();
+        }
+    }
+
+    pub fn correction(
+        &self,
+        key: RoutingPartitionId,
+        block_size: u32,
+    ) -> Arc<dyn OverlapCorrection> {
+        Arc::new(GroupCorrection {
+            index: self.clone(),
+            key,
+            block_size,
+        })
+    }
+}
+
+struct GroupCorrection {
+    index: GroupReuseIndex,
+    key: RoutingPartitionId,
+    block_size: u32,
+}
+
+impl OverlapCorrection for GroupCorrection {
+    fn required(&self) -> bool {
+        self.index.contains_partition(&self.key)
+    }
+
+    fn correct(&self, overlap: &mut OverlapSignals, query: Option<&GroupReuseQuery>) {
+        self.index
+            .correct(&self.key, self.block_size, overlap, query);
+    }
+}
