+// SPDX-License-Identifier: Apache-2.0
+
+use std::collections::{BTreeMap, HashSet};
+
+use dynamo_protocols::types::{
+    ChatCompletionMessageContent, ChatCompletionMessageToolCall,
+    ChatCompletionMessageToolCallChunk, ChatCompletionRequestAssistantMessage,
+    ChatCompletionRequestAssistantMessageContent, CreateChatCompletionStreamResponse, FinishReason,
+    FunctionCall, FunctionType, ReasoningContent, Role,
+};
+
+#[derive(Default)]
+pub(super) struct CompletedAssistant {
+    content: Option<String>,
+    reasoning: Option<String>,
+    refusal: Option<String>,
+    tools: BTreeMap<u32, ChatCompletionMessageToolCallChunk>,
+    completion: BTreeMap<u32, bool>,
+    finish_reason: Option<FinishReason>,
+    failed: bool,
+}
+
+impl CompletedAssistant {
+    pub(super) fn reject(&mut self) {
+        self.failed = true;
+    }
+
+    pub(super) fn observe_completion(&mut self, choice: u32, tool: u32, complete: bool) {
+        if choice != 0 {
+            self.reject();
+            return;
+        }
+        self.completion
+            .entry(tool)
+            .and_modify(|old| *old |= complete)
+            .or_insert(complete);
+    }
+
+    pub(super) fn observe(&mut self, response: &CreateChatCompletionStreamResponse) {
+        // Usage-only frames may follow the terminal choice.
+        if response.choices.is_empty() {
+            return;
+        }
+        if self.failed
+            || self.finish_reason.is_some()
+            || response.choices.len() != 1
+            || response.choices[0].index != 0
+        {
+            self.reject();
+            return;
+        }
+        let choice = &response.choices[0];
+        let delta = &choice.delta;
+        if delta.function_call.is_some()
+            || delta
+                .role
+                .as_ref()
+                .is_some_and(|role| *role != Role::Assistant)
+        {
+            self.reject();
+            return;
+        }
+        if let Some(content) = &delta.content {
+            let ChatCompletionMessageContent::Text(text) = content else {
+                self.reject();
+                return;
+            };
+            self.content.get_or_insert_with(String::new).push_str(text);
+        }
+        for (source, target) in [
+            (&delta.reasoning_content, &mut self.reasoning),
+            (&delta.refusal, &mut self.refusal),
+        ] {
+            if let Some(text) = source {
+                target.get_or_insert_with(String::new).push_str(text);
+            }
+        }
+        for chunk in delta.tool_calls.iter().flatten() {
+            let Some(existing) = self.tools.get_mut(&chunk.index) else {
+                self.tools.insert(chunk.index, chunk.clone());
+                continue;
+            };
+            if let Some(id) = &chunk.id {
+                if existing.id.as_ref().is_some_and(|old| old != id) {
+                    self.failed = true;
+                    return;
+                }
+                existing.id = Some(id.clone());
+            }
+            if let Some(function) = &chunk.function {
+                let saved = existing.function.get_or_insert_with(Default::default);
+                if let Some(name) = &function.name {
+                    if saved.name.as_ref().is_some_and(|old| old != name) {
+                        self.failed = true;
+                        return;
+                    }
+                    saved.name = Some(name.clone());
+                }
+                if let Some(args) = &function.arguments {
+                    saved
+                        .arguments
+                        .get_or_insert_with(String::new)
+                        .push_str(args);
+                }
+            }
+        }
+        self.finish_reason = choice.finish_reason;
+    }
+
+    pub(super) fn finish(self) -> Option<ChatCompletionRequestAssistantMessage> {
+        if self.failed
+            || !matches!(
+                self.finish_reason,
+                Some(FinishReason::Stop | FinishReason::ToolCalls)
+            )
+        {
+            return None;
+        }
+        if (self.finish_reason == Some(FinishReason::ToolCalls)) != !self.tools.is_empty() {
+            return None;
+        }
+        if self.tools.is_empty()
+            && [&self.content, &self.reasoning, &self.refusal]
+                .into_iter()
+                .all(|field| field.as_ref().is_none_or(String::is_empty))
+        {
+            return None;
+        }
+        let mut ids = HashSet::new();
+        let mut tools = Vec::new();
+        for (expected, (index, chunk)) in self.tools.into_iter().enumerate() {
+            let id = chunk.id?;
+            let function = chunk.function?;
+            let name = function.name?;
+            let arguments = function.arguments.unwrap_or_default();
+            if index as usize != expected
+                || id.is_empty()
+                || name.is_empty()
+                || !ids.insert(id.clone())
+                || self.completion.get(&index) == Some(&false)
+                || (!arguments.is_empty()
+                    && !serde_json::from_str::<serde_json::Value>(&arguments)
+                        .ok()?
+                        .is_object())
+            {
+                return None;
+            }
+            tools.push(ChatCompletionMessageToolCall {
+                id,
+                r#type: FunctionType::Function,
+                function: FunctionCall { name, arguments },
+            });
+        }
+        Some(ChatCompletionRequestAssistantMessage {
+            content: self
+                .content
+                .map(ChatCompletionRequestAssistantMessageContent::Text),
+            reasoning_content: self.reasoning.map(ReasoningContent::Text),
+            refusal: self.refusal,
+            tool_calls: (!tools.is_empty()).then_some(tools),
+            ..Default::default()
+        })
+    }
+}
