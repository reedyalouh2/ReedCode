+        let mut turn = CompletedAssistant::default();
+        turn.observe(&chunk(
+            json!({"tool_calls":[tool(0,"a","read","{")]}),
+            Value::Null,
+        ));
+        turn.observe(&chunk(
+            json!({"tool_calls":[tool(0,"b","read","}")]}),
+            json!("tool_calls"),
+        ));
+        assert!(turn.finish().is_none());
+    }
+
+    #[test]
+    fn skips_missing_finish_length_extra_choices_and_late_errors() {
+        for finish in [Value::Null, json!("length"), json!("content_filter")] {
+            let mut turn = CompletedAssistant::default();
+            turn.observe(&chunk(json!({"content":"answer"}), finish));
+            assert!(turn.finish().is_none());
+        }
+        let mut turn = CompletedAssistant::default();
+        let mut response = chunk(json!({"content":"answer"}), json!("stop"));
+        response.choices.push(response.choices[0].clone());
+        turn.observe(&response);
+        assert!(turn.finish().is_none());
+        let mut turn = CompletedAssistant::default();
+        turn.observe(&chunk(json!({"content":"answer"}), json!("stop")));
+        turn.reject();
+        assert!(turn.finish().is_none());
+    }
+
+    #[test]
+    fn completion_evidence_must_finish_provisional_calls() {
+        for complete in [false, true] {
+            let mut turn = CompletedAssistant::default();
+            turn.observe(&chunk(
+                json!({"tool_calls":[tool(0,"a","read","{}")]}),
+                json!("tool_calls"),
+            ));
+            turn.observe_completion(0, 0, false);
+            if complete {
+                turn.observe_completion(0, 0, true);
+            }
+            assert_eq!(turn.finish().is_some(), complete);
+        }
+    }
+    #[test]
+    fn skips_empty_and_non_text_responses() {
+        for delta in [
+            json!({}),
+            json!({"content":""}),
+            json!({"content":[{"type":"text","text":"part"}]}),
+        ] {
+            let mut turn = CompletedAssistant::default();
+            turn.observe(&chunk(delta, json!("stop")));
+            assert!(turn.finish().is_none());
+        }
+    }
