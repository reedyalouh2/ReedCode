(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:*"))
(deny file-write*)
(allow file-write* (subpath "/private/tmp/reedcode-parity-runner-claude-final") (literal "/dev/null") (literal "/dev/tty"))
(deny mach-lookup (global-name "com.apple.securityd"))
(deny file-read-data (subpath "/Users/mohamed/.agents"))
(deny file-read-data (subpath "/Users/mohamed/.aws"))
(deny file-read-data (subpath "/Users/mohamed/.azure"))
(deny file-read-data (subpath "/Users/mohamed/.claude"))
(deny file-read-data (subpath "/Users/mohamed/.codex"))
(deny file-read-data (subpath "/Users/mohamed/.config"))
(deny file-read-data (subpath "/Users/mohamed/.docker"))
(deny file-read-data (subpath "/Users/mohamed/.huggingface"))
(deny file-read-data (subpath "/Users/mohamed/.kube"))
(deny file-read-data (subpath "/Users/mohamed/.runpod"))
(deny file-read-data (subpath "/Users/mohamed/.ssh"))
(deny file-read-data (subpath "/Users/mohamed/Library/Keychains"))
(deny file-read-data (subpath "/private/tmp/reedcode-gpu-credentials"))
(deny file-read-data (subpath "/private/tmp/reedcode-prefix-auth"))
(deny file-read-data (subpath "/private/tmp/reedcode-runpod-auth"))
(deny file-read-data (subpath "/tmp/reedcode-gpu-credentials"))
(deny file-read-data (subpath "/tmp/reedcode-prefix-auth"))
(deny file-read-data (subpath "/tmp/reedcode-runpod-auth"))
(deny file-read-data (literal "/Users/mohamed/.claude.json"))
(deny file-read-data (literal "/Users/mohamed/.netrc"))
(deny file-read-data (literal "/Users/mohamed/.git-credentials"))
(deny file-read-data (literal "/Users/mohamed/.npmrc"))
(deny file-read-data (literal "/Users/mohamed/.pypirc"))
(deny file-read-data (literal "/Users/mohamed/.cache/huggingface/token"))
